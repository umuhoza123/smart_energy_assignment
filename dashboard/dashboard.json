          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  time_bucket('1 hour', \"timestamp\") AS time,\r\n  CASE \r\n    WHEN \"timestamp\"::date = CURRENT_DATE THEN 'Today'\r\n    WHEN \"timestamp\"::date = (CURRENT_DATE - INTERVAL '1 day')::date THEN 'Yesterday'\r\n  END AS metric,\r\n  AVG(power) AS avg_power\r\nFROM energy_readings\r\nWHERE \"timestamp\" >= (CURRENT_DATE - INTERVAL '1 day')\r\n  AND \"timestamp\" < (CURRENT_DATE + INTERVAL '1 day')\r\nGROUP BY 1, 2\r\nORDER BY 1;\r\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
