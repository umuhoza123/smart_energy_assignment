          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH c AS (\r\n  SELECT\r\n    ch.hypertable_name,\r\n    ch.is_compressed,\r\n    s.total_bytes\r\n  FROM timescaledb_information.chunks ch\r\n  JOIN chunks_detailed_size('public.energy_readings') s\r\n    ON s.chunk_schema = ch.chunk_schema\r\n   AND s.chunk_name  = ch.chunk_name\r\n  WHERE ch.hypertable_name LIKE 'energy_readings%'\r\n)\r\nSELECT\r\n  hypertable_name,\r\n  SUM(CASE WHEN is_compressed = false THEN total_bytes ELSE 0 END) AS raw_bytes,\r\n  SUM(CASE WHEN is_compressed = true  THEN total_bytes ELSE 0 END) AS compressed_bytes,\r\n  ROUND(\r\n    SUM(CASE WHEN is_compressed = false THEN total_bytes ELSE 0 END)::numeric\r\n    / NULLIF(SUM(CASE WHEN is_compressed = true THEN total_bytes ELSE 0 END), 0),\r\n    2\r\n  ) AS compression_ratio\r\nFROM c\r\nGROUP BY hypertable_name\r\nORDER BY hypertable_name\r\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
